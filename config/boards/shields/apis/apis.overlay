#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <6>;

        map = <
            RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)    
            RC(4,4) RC(4,3) RC(4,2) RC(4,1) RC(4,0) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)    
            RC(5,4) RC(5,3) RC(5,2) RC(5,1) RC(5,0) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)    
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";

        debounce-press-ms = <10>;
        debounce-release-ms = <10>;

        /* Rows (Output): Active Low */
        row-gpios
            = <&xiao_d 0 GPIO_ACTIVE_LOW>
            , <&xiao_d 1 GPIO_ACTIVE_LOW>
            , <&xiao_d 2 GPIO_ACTIVE_LOW>
            , <&xiao_d 3 GPIO_ACTIVE_LOW>
            , <&xiao_d 4 GPIO_ACTIVE_LOW>
            , <&xiao_d 5 GPIO_ACTIVE_LOW>
            ;

        /* Columns (Input): Active Low with Pull-Up */
        col-gpios
            = <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&xiao_d 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&xiao_d 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&xiao_d 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&xiao_d 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };
};

/* Disable hardware buses sharing pins D6-D10 */
&xiao_serial { status = "disabled"; };
&sercom0 { status = "disabled"; };
&sercom4 { status = "disabled"; };
