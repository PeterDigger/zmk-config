#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        lt_spc: layer_tap_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Essentials */
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };
        combo_bsck {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp BSPC>;
        };
        combo_enter {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&kp RET>;
        };
        combo_tab {
            timeout-ms = <50>;
            key-positions = <0 1 2>;
            bindings = <&kp TAB>;
        };

        /* Left side Vertical Combos */
        combo_backslash {
            timeout-ms = <50>;
            key-positions = <0 10>;
            bindings = <&kp BSLH>;
            layers = <0>;
        };
        combo_left_bracket {
            timeout-ms = <50>;
            key-positions = <1 11>;
            bindings = <&kp LBKT>;
            layers = <0>;
        };
        combo_left_brace {
            timeout-ms = <50>;
            key-positions = <2 12>;
            bindings = <&kp LBRC>;
            layers = <0>;
        };
        combo_left_parenthesis {
            timeout-ms = <50>;
            key-positions = <3 13>;
            bindings = <&kp LPAR>;
            layers = <0>;
        };
        combo_less_than {
            timeout-ms = <50>;
            key-positions = <4 14>;
            bindings = <&kp LT>;
            layers = <0>;
        };

        /* Right side Vertical Combos */
        combo_greater_than {
            timeout-ms = <50>;
            key-positions = <5 15>;
            bindings = <&kp GT>;
            layers = <0>;
        };
        combo_right_parenthesis {
            timeout-ms = <50>;
            key-positions = <6 16>;
            bindings = <&kp RPAR>;
            layers = <0>;
        };
        combo_right_brace {
            timeout-ms = <50>;
            key-positions = <7 17>;
            bindings = <&kp RBRC>;
            layers = <0>;
        };
        combo_right_bracket {
            timeout-ms = <50>;
            key-positions = <8 18>;
            bindings = <&kp RBKT>;
            layers = <0>;
        };
        combo_slash {
            timeout-ms = <50>;
            key-positions = <9 19>;
            bindings = <&kp FSLH>;
            layers = <0>;
        };

        /* Row Combos */
        combo_single_quote {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp SQT>;
            layers = <0>;
        };
        combo_grave {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp GRAVE>;
            layers = <0>;
        };
         combo_full_stop {
            timeout-ms = <50>;
            key-positions = <28 29>;
            bindings = <&kp DOT>;
            layers = <0>;
        };   };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q         &kp W         &kp E         &kp R         &kp T               &kp Y             &kp U         &kp I         &kp O         &kp P
                &hm LSHFT A   &hm LALT S    &hm LCTRL D   &hm LGUI F    &kp G               &kp H             &hm RGUI J    &hm RCTRL K   &hm RALT L    &hm RSHFT SEMI
                &kp Z         &kp X         &kp C         &kp V         &lt_spc 1 BSPC       &lt_spc 2 SPC    &kp B         &kp N         &kp M         &kp COMMA
            >;
        };

        left_layer {
            bindings = <
                &kp N1        &kp N2        &kp N3        &kp N4        &none               &none             &kp HOME      &kp PG_DN     &kp PG_UP     &kp END
                &hm LSHFT N5  &hm LALT N6   &hm LCTRL N7  &hm LGUI N8   &none               &none             &hm RGUI LEFT &hm RCTRL DOWN &hm RALT UP  &hm RSHFT RIGHT
                &kp N9        &kp N0        &kp MINUS     &kp EQUAL     &trans              &kp TILDE         &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PP
            >;
        };

        right_layer {
            bindings = <
                &kp F1        &kp F2        &kp F3        &kp F4        &none               &none             &none         &none         &none         &none
                &hm LSHFT F5  &hm LALT F6   &hm LCTRL F7  &hm LGUI F8   &none               &none             &none         &none         &none         &none
                &kp F9        &kp F10       &kp F11       &kp F12       &none               &trans            &none         &none         &none         &none
            >;
        };
    };
};
